{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/argos-ai-xdr/argos-control/releases/schema/release-manifest.schema.json",
  "title": "ARGOS release manifest",
  "description": "Fija los commits, imágenes y contratos compatibles que forman una release reconstruible de argos-ai-xdr. Ver ADR-014, ADR-015 y compatibility/contracts.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "status", "created_at", "repositories"],
  "properties": {
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "SemVer, p. ej. 0.1.0 o 0.9.0-rc.1"
    },
    "status": {
      "type": "string",
      "enum": ["dev", "candidate", "released"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "object",
      "description": "Un commit por cada repositorio funcional (no incluye argos-control, que es quien define la release).",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["commit"],
        "additionalProperties": false,
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        }
      }
    },
    "images": {
      "type": "object",
      "description": "Solo obligatorio para status=candidate|released. Toda imagen se referencia por digest, nunca por tag.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.\\-_/]+@sha256:[a-f0-9]{64}$"
      }
    },
    "contracts": {
      "type": "object",
      "description": "Versión SemVer de cada contrato de compatibility/contracts.yaml usada por esta release.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "run_id", "evidence_manifest"],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "evidence_manifest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "candidate" } }
      },
      "then": {
        "required": ["images", "contracts", "validation"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "released" } }
      },
      "then": {
        "required": ["images", "contracts", "validation"]
      }
    }
  ]
}
